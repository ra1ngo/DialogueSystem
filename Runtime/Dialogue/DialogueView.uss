#dialogue-root {
    visibility: hidden;

    position: absolute;

    left: 10%;
    right: 10%;

    min-height: 120px;

    padding: 20px;

    background-color: rgb(30, 30, 30);
}

.dialogue-continue {
    display: none;

    position: absolute;

    right: 14px;
    bottom: 10px;

    color: white;
    font-size: 18px;

    -unity-text-align: middle-center;
}

#dialogue-content {
    flex-grow: 1;
    flex-shrink: 1;
}

#dialogue-speaker {
    margin-bottom: 8px;

    color: white;
    font-size: 20px;
}

.dialogue-text-viewport {
    position: relative;

    height: 150px;
    flex-shrink: 0;

    overflow: hidden;
}

.dialogue-text--measure {
    position: absolute;
    visibility: hidden;

    left: 0;
    top: 0;
}

.dialogue-text {
    color: white;
    font-size: 24px;

    white-space: normal;

    flex-shrink: 1;
}


/* -------------------------
   Presentations
   ------------------------- */

.dialogue-standard {
    bottom: 40px;
}

.dialogue-system {
    top: 40px;
}